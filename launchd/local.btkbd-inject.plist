<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.btkbd-inject</string>
    <key>ProgramArguments</key><array><string>/usr/local/btkbd/btkbd-inject</string></array>
    <key>LimitLoadToSessionType</key><array><string>LoginWindow</string><string>Aqua</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>3</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>StandardOutPath</key><string>/tmp/btkbd-inject.log</string>
    <key>StandardErrorPath</key><string>/tmp/btkbd-inject.log</string>
</dict>
</plist>
